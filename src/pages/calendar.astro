---
// Phase 4 — the calendar view, redesigned.
//
// A row-major twelve-box grid, standard Jan→Dec reading order, with a day
// timeline inside each box. Replaces the CSS multi-column version, which read
// column-major (all the way down column one, back to the top for column two)
// and, being a stack of event cards, read as the list view in boxes. The
// reasoning for the layout and for what the redesign cost is in
// ARCHITECTURE.md §7 item 4.
//
// Filtering is the same engine as the list view — same src/lib/filters.ts, same
// URL params, same client script. Switching views is a navigation that carries
// the query string, not a state reset (§4.5).
import CalendarMonth from '../components/CalendarMonth.astro';
import FilterBar from '../components/FilterBar.astro';
import ViewSwitch from '../components/ViewSwitch.astro';
import Base from '../layouts/Base.astro';
import { MONTH_NAMES } from '../lib/filters';
import { allRaces, byMonth } from '../lib/races';

const races = allRaces();
const total = races.length;
const counted = races.filter((r) => r.counted).length;

const months = byMonth(races);
const present = new Set(races.map((r) => r.status));

/*
 * The jump strip, kept but re-scoped.
 *
 * Phase 4's version was twelve bars scaled to the busiest month, doing two jobs
 * at once: a season density profile and month navigation. The redesign takes
 * the first job away from it — each box now draws its own days, which shows
 * density better than an abstract bar because it shows *when* as well as *how
 * many*, and two density visualizations on one page compete. So the bars are
 * gone and only the navigation remains.
 *
 * That navigation is itself only needed below the three-column breakpoint. On a
 * wide screen the row-major grid is the whole year on roughly a screen and a
 * half and you can simply look at October; on a phone it's twelve boxes in one
 * column and reaching October means scrolling past September's twenty events.
 * So the strip is hidden at >=68rem rather than deleted — it survives exactly
 * where it still earns its place.
 */
const strip = months
  .filter((m) => m.month !== null)
  .map((m) => ({
    key: String(m.month),
    abbr: MONTH_NAMES[m.month! - 1].slice(0, 3),
    label: MONTH_NAMES[m.month! - 1],
    n: m.races.filter((r) => r.counted).length,
  }));

const description = `A twelve-month calendar of ${counted} Colorado ultramarathons — every race on its day, filterable by format, distance, region and month.`;
---

<Base title="Calendar — GnarList Colorado Ultramarathons" description={description}>
  <header class="masthead">
    <div class="shell">
      <p class="eyebrow">Colorado &middot; Ultramarathon Index</p>
      <h1>A Typical Year<br />on the High Ground</h1>
      <p class="deck">
        {counted} events, January to December. The season has a shape — it shows.
      </p>
    </div>
  </header>

  <main class="shell">
    <ViewSwitch current="calendar" />

    <p class="howto">
      Each month draws its own days — every race sits on the day it runs, and multi-day races
      stretch across theirs. Point at a mark to find it in the list below; tap it to pull the
      race up. Filters carry over from the list and map views, and back.
    </p>

    <FilterBar races={races} />

    <p class="legend">
      <span class="key"><i class="k-mk k-marquee" /> Marquee</span>
      {present.has('returning') && <span class="key"><i class="k-mk k-returning" /> Returning</span>}
      {present.has('discontinued') && (
        <span class="key"><i class="k-mk k-discontinued" /> Discontinued</span>
      )}
      {present.has('unverified') && (
        <span class="key"><i class="k-mk k-unverified" /> Unverified</span>
      )}
      <span class="key"><i class="k-tilde">~</i> Day not confirmed — parked left of the axis</span>
    </p>

    <nav class="strip" aria-label="Jump to month">
      {
        strip.map((m) => (
          <a href={`#m-${m.key}`} data-strip={m.key} title={m.label}>
            {m.abbr}
            <b data-strip-count>{m.n}</b>
          </a>
        ))
      }
    </nav>

    <noscript>
      <p class="noscript">
        Filtering needs JavaScript. All {total} events are on the calendar regardless, and every
        timeline mark is a link straight to its race.
      </p>
    </noscript>

    <div class="year">
      {
        months.map((m) => (
          <div
            class:list={['slot', !m.month && 'slot-nodate']}
            id={m.month ? `m-${m.month}` : 'm-none'}
          >
            <CalendarMonth month={m.month} races={m.races} />
          </div>
        ))
      }
    </div>

    <p class="empty" data-empty hidden>
      Nothing on the calendar matches all of that. Loosen a filter — or switch on
      <em>Sub&#8209;50K</em> if you're after something shorter.
    </p>

    <footer class="foot">
      <p>
        {counted} events across the season, plus {total - counted} listed for the record. The map
        view shows where they all are.
      </p>
      <p>
        Built with Astro on Cloudflare Workers &middot;
        <a href="https://github.com/ChrisGrundemann/gnarlist">source on GitHub</a>
      </p>
    </footer>
  </main>

  <script>
    import '../scripts/filter-client';
    import '../scripts/calendar-timeline';
  </script>
</Base>

<style>
  .masthead {
    padding: clamp(1.75rem, 5vw, 3.25rem) 0 clamp(1.25rem, 3vw, 2rem);
    border-bottom: 1px solid var(--line);
    background: linear-gradient(180deg, transparent, rgb(242 184 67 / 3%)), transparent;
  }
  h1 {
    font-size: clamp(2rem, 6.2vw, 3.6rem);
    line-height: 0.95;
    letter-spacing: -0.005em;
    text-transform: uppercase;
    margin: 0.35rem 0 0;
    background: linear-gradient(175deg, #fff 10%, var(--gold) 150%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .deck {
    margin: 0.8rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1rem, 2.8vw, 1.25rem);
    color: var(--fg-dim);
    max-width: 42ch;
  }

  main {
    padding: clamp(1.25rem, 3vw, 2rem) 0 4rem;
  }
  .howto {
    margin: 0 0 1.25rem;
    max-width: 62ch;
    font-size: 0.9rem;
    color: var(--fg-dim);
  }

  /* ---- legend: the timeline's marks, in the marks' own shape ---- */
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    margin: 0 0 0.9rem;
    font-size: 0.72rem;
    color: var(--fg-mute);
  }
  .key {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .k-mk {
    width: 9px;
    height: 5px;
    display: inline-block;
    border-radius: 1px;
  }
  .k-marquee {
    background: var(--gold);
  }
  .k-returning {
    background: var(--teal-deep);
  }
  .k-discontinued {
    background: var(--rust);
  }
  .k-unverified {
    background: repeating-linear-gradient(90deg, var(--gold-deep) 0 2px, transparent 2px 4px);
  }
  .k-tilde {
    font-style: normal;
    font-family: var(--font-mono);
    border-bottom: 1px dotted var(--fg-mute);
  }

  /* ---- month jump strip: navigation only, and only where it's needed ---- */
  .strip {
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
    margin: 0 0 1.1rem;
    padding: 0.3rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--ink-850);
  }
  .strip a {
    flex: 1 1 auto;
    display: inline-flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.3rem;
    padding: 0.45rem 0.3rem;
    border-radius: 2px;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-dim);
    text-decoration: none;
  }
  .strip a b {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--fg-mute);
    font-variant-numeric: tabular-nums;
  }
  .strip a:hover {
    background: var(--ink-800);
    color: var(--fg);
  }
  /* A month the current filter has emptied keeps its slot — the year keeps its
     shape — it just stops advertising itself as somewhere to go. */
  .strip a.is-empty {
    opacity: 0.35;
  }

  /*
   * The year, row-major.
   *
   * Plain CSS Grid, reading left-to-right and top-to-bottom, which is the whole
   * point of the redesign. `align-items: start` matters: a grid row is as tall
   * as its tallest box, and letting the short boxes stretch would put the dead
   * space *inside* an empty-looking card instead of below an honestly-sized
   * one. Three across on a wide screen is deliberate — it makes each row a
   * calendar quarter, and in a seasonal sport quarters group months of similar
   * density, which is what keeps the wasted space bounded. See ARCHITECTURE.md
   * §7 item 4 for the alternatives and why they lost.
   */
  .year {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: 1rem;
  }
  .slot {
    scroll-margin-top: 1rem;
  }
  /* The one record with no month at all doesn't belong in a quarter. */
  .slot-nodate {
    grid-column: 1 / -1;
  }

  @media (min-width: 46rem) {
    .year {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 68rem) {
    .year {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.1rem;
    }
    /* The grid is the navigation at this width. */
    .strip {
      display: none;
    }
  }

  .noscript {
    margin: 0 0 1rem;
    padding: 0.7rem 0.9rem;
    border-left: 3px solid var(--gold-deep);
    background: var(--gold-wash);
    font-size: 0.85rem;
    color: var(--fg-dim);
  }

  .empty {
    margin: 0;
    padding: 2.5rem 1rem;
    text-align: center;
    color: var(--fg-dim);
  }
  .empty em {
    color: var(--teal);
    font-style: normal;
  }

  .foot {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    color: var(--fg-mute);
    font-size: 0.8rem;
  }
  .foot p {
    margin: 0 0 0.35rem;
  }
</style>
