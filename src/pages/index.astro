---
// Phase 3 — the list view.
//
// Every race in data/races.json is rendered here at build time, sorted into one
// seasonal Jan-to-Dec arc. Filtering happens in the browser against rows that
// are already on the page (see src/scripts/filter-client.ts), so the full list
// works with JavaScript off and there is nothing to fetch.
import FilterBar from '../components/FilterBar.astro';
import RaceRow from '../components/RaceRow.astro';
import ViewSwitch from '../components/ViewSwitch.astro';
import Base from '../layouts/Base.astro';
import { MONTH_NAMES, REGIONS } from '../lib/filters';
import { allRaces } from '../lib/races';

const races = allRaces();

// `total` is how many rows the page renders; `counted` is how many of those
// contribute to a displayed number (races.ts `countsTowardTotals`). They differ
// by the events that are listed for the record but aren't races anyone can
// enter. Every headline figure below is the counted one; `total` only ever
// describes the list itself.
//
// The breakdown is derived, never written out by hand. It used to read "one
// discontinued, one unverified", which silently became false the moment
// Sourdough Snowshoe was verified and promoted to active — copy that states a
// fact about the data should be computed from the data.
const total = races.length;
const counting = races.filter((r) => r.counted);
const counted = counting.length;

/** Statuses present in the dataset right now, so the legend can't advertise a
 *  key with no rows behind it (as `unverified` did once Sourdough moved). */
const present = new Set(races.map((r) => r.status));

/** e.g. `one discontinued`, or `one discontinued and two unverified`. */
const NUMBER_WORDS = ['no', 'one', 'two', 'three', 'four', 'five'];
const uncountedBreakdown = (() => {
  const tally = new Map<string, number>();
  for (const r of races) if (!r.counted) tally.set(r.status, (tally.get(r.status) ?? 0) + 1);
  const parts = [...tally].map(([status, n]) => `${NUMBER_WORDS[n] ?? n} ${status}`);
  if (parts.length === 0) return '';
  if (parts.length === 1) return parts[0];
  return `${parts.slice(0, -1).join(', ')} and ${parts.at(-1)}`;
})();

/** Sentence for the legend, naming only the statuses that actually occur. */
const uncountedRule = (() => {
  const kinds = (['discontinued', 'unverified'] as const).filter((k) => present.has(k));
  if (kinds.length === 0) return '';
  const label = kinds.length === 2 ? 'Discontinued and unverified' :
    kinds[0].charAt(0).toUpperCase() + kinds[0].slice(1);
  return `${label} events are listed, but not counted.`;
})();
const marquee = counting.filter((r) => r.marquee).length;
const regions = new Set(counting.map((r) => r.location.region)).size;
const longest = counting.reduce((a, b) => Math.max(a, b.longest_ultra_miles ?? 0), 0);

// Group into month sections. The one permanently-cancelled event has no month
// at all; it gets its own trailing section rather than being quietly dropped.
type Section = { key: string; label: string; races: typeof races };
const sections: Section[] = [];
for (const race of races) {
  const key = race.month ? String(race.month) : '';
  const label = race.month ? MONTH_NAMES[race.month - 1] : 'No date';
  if (sections.at(-1)?.key !== key) sections.push({ key, label, races: [] });
  sections.at(-1)!.races.push(race);
}

const description = `A filterable list of ${counted} Colorado ultramarathons — by format, distance, region and month.`;
---

<Base title="GnarList — Colorado Ultramarathons" description={description}>
  <header class="masthead">
    <div class="shell">
      <p class="eyebrow">Colorado &middot; Ultramarathon Index</p>
      <h1>GnarList</h1>
      <p class="deck">
        <strong>{counted}</strong> ways to spend a very long day on the high ground.
      </p>
      <p class="stats">
        <span
          title={`${total} events are listed in full, including ${total - counted} that ${
            total - counted === 1 ? "doesn't" : "don't"
          } count toward any total — ${uncountedBreakdown}.`}
          ><b>{total}</b> listed</span
        >
        <span><b>{marquee}</b> marquee</span>
        <span><b>{regions}</b> regions</span>
        <span><b>{longest}</b> miles at the far end</span>
      </p>
    </div>
  </header>

  <main class="shell">
    <ViewSwitch current="list" />

    <p class="howto">
      Filter by format, distance, region or month — they stack, and they carry over to the
      calendar. The address bar keeps up, so whatever you're looking at can be copied,
      bookmarked or sent to somebody else. Tap any race for its full record.
    </p>

    <FilterBar races={races} />

    <p class="legend">
      <span class="key"><i class="k-star">★</i> Marquee</span>
      {present.has('returning') && <span class="key"><i class="k-bar k-returning" /> Returning</span>}
      {present.has('discontinued') && (
        <span class="key"><i class="k-bar k-discontinued" /> Discontinued</span>
      )}
      {present.has('unverified') && (
        <span class="key"><i class="k-bar k-unverified" /> Unverified</span>
      )}
      <span class="key"><i class="k-tilde">~</i> Date not confirmed</span>
      {uncountedRule && <span class="key note">{uncountedRule}</span>}
    </p>

    <div class="cols" aria-hidden="true">
      <span>When</span>
      <span>Race</span>
      <span>Where</span>
      <span>Distances</span>
    </div>

    <noscript>
      <p class="noscript">
        Filtering needs JavaScript. All {total} events are listed below regardless.
      </p>
    </noscript>

    <ul class="race-list" data-race-list>
      {
        sections.map((section) => (
          <Fragment>
            <li class="month-break" data-break data-month={section.key}>
              <span>{section.label}</span>
            </li>
            {section.races.map((race) => (
              <RaceRow race={race} />
            ))}
          </Fragment>
        ))
      }
    </ul>

    <p class="empty" data-empty hidden>
      Nothing on the list matches all of that. Loosen a filter — or switch on
      <em>Sub&#8209;50K</em> if you're after something shorter.
    </p>

    <footer class="foot">
      <p>
        {counted} events across {REGIONS.length} Colorado regions, plus {total - counted} listed for
        the record. Hand-verified, corrections welcome. The map view is next.
      </p>
      <p>
        Built with Astro on Cloudflare Workers &middot;
        <a href="https://github.com/ChrisGrundemann/gnarlist">source on GitHub</a>
      </p>
    </footer>
  </main>

  <script>
    import '../scripts/filter-client';
  </script>
</Base>

<style>
  .masthead {
    padding: clamp(2.25rem, 7vw, 4.5rem) 0 clamp(1.5rem, 4vw, 2.5rem);
    border-bottom: 1px solid var(--line);
    background:
      linear-gradient(180deg, transparent, rgb(242 184 67 / 3%)),
      transparent;
  }
  h1 {
    font-size: clamp(3.2rem, 13vw, 7rem);
    line-height: 0.88;
    letter-spacing: -0.005em;
    text-transform: uppercase;
    margin: 0.35rem 0 0;
    background: linear-gradient(175deg, #fff 10%, var(--gold) 130%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .deck {
    margin: 0.9rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 3.4vw, 1.6rem);
    font-weight: 400;
    line-height: 1.25;
    color: var(--fg-dim);
    max-width: 30ch;
  }
  .deck strong {
    color: var(--gold);
    font-weight: 700;
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    margin: 1.1rem 0 0;
    font-family: var(--font-display);
    font-size: 0.76rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-mute);
  }
  .stats b {
    color: var(--teal);
    font-variant-numeric: tabular-nums;
  }

  main {
    padding: clamp(1.5rem, 4vw, 2.5rem) 0 4rem;
  }
  .howto {
    margin: 0 0 1.25rem;
    max-width: 58ch;
    font-size: 0.9rem;
    color: var(--fg-dim);
  }

  /* ---- legend ---- */
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    margin: 0 0 0.9rem;
    font-size: 0.72rem;
    color: var(--fg-mute);
  }
  .key {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .k-star {
    color: var(--gold);
    font-style: normal;
  }
  .note {
    color: var(--fg-mute);
    font-style: italic;
  }
  .k-tilde {
    font-style: normal;
    font-family: var(--font-mono);
    border-bottom: 1px dotted var(--fg-mute);
  }
  .k-bar {
    width: 3px;
    height: 0.85rem;
    display: inline-block;
  }
  .k-returning {
    background: var(--teal-deep);
  }
  .k-discontinued {
    background: var(--rust);
  }
  .k-unverified {
    background: repeating-linear-gradient(
      180deg,
      var(--gold-deep) 0 3px,
      transparent 3px 6px
    );
  }

  /* ---- column headers: desktop only, they'd be noise stacked ---- */
  .cols {
    display: none;
  }
  @media (min-width: 60rem) {
    .cols {
      display: grid;
      grid-template-columns: 6.5rem minmax(0, 1fr) 11rem 15rem;
      gap: 0 1.25rem;
      padding: 0 1rem 0.5rem 0.85rem;
      border-bottom: 1px solid var(--line);
      font-family: var(--font-display);
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--fg-mute);
    }
  }

  .race-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-soft);
  }

  /* ---- month rules: the poster's season spine ---- */
  .month-break {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1.5rem 1rem 0.5rem 0.85rem;
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .month-break::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--gold-edge), transparent);
  }
  .month-break:first-child {
    padding-top: 0.75rem;
  }

  .noscript {
    margin: 0 0 1rem;
    padding: 0.7rem 0.9rem;
    border-left: 3px solid var(--gold-deep);
    background: var(--gold-wash);
    font-size: 0.85rem;
    color: var(--fg-dim);
  }

  .empty {
    margin: 0;
    padding: 3rem 1rem;
    text-align: center;
    color: var(--fg-dim);
    border-bottom: 1px solid var(--line-soft);
  }
  .empty em {
    color: var(--teal);
    font-style: normal;
  }

  .foot {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    color: var(--fg-mute);
    font-size: 0.8rem;
  }
  .foot p {
    margin: 0 0 0.35rem;
  }
</style>
