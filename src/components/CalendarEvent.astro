---
// One event inside a calendar month block.
//
// Visual hierarchy is Phase 3's, not a new one (ARCHITECTURE.md §2.5): ★ marquee
// gets the larger, gold-washed treatment; returning is a teal rule; discontinued
// is a rust rule over hatching; unverified is a dashed gold rule. Distance
// badges are the same teal-on-wash chips the list uses, just fewer of them —
// a calendar cell has a fraction of a list row's width.
import { FORMATS } from '../lib/filters';
import { STATUS_NOTE, filterAttrs, raceHref, type RaceView } from '../lib/races';

interface Props {
  race: RaceView;
}

const { race } = Astro.props;
const status = race.status === 'active' ? null : STATUS_NOTE[race.status];

const formatLabels = new Map(FORMATS.map((f) => [f.value, f.label]));
const formatTags = race.tokens.formats
  .filter((f) => f !== 'standard')
  .map((f) => formatLabels.get(f) ?? f);

// The lead glyph. A confirmed date gets its day number (the calendar read);
// anything else gets a tilde, matching the list view's convention for a date
// the organizer hasn't actually announced. The full string is the tooltip
// either way, so nothing is lost by the compression.
const day = (() => {
  if (!race.date_start) return { text: '~', approx: true };
  const d = Number(race.date_start.slice(8, 10));
  if (race.date_end) {
    const ed = Number(race.date_end.slice(8, 10));
    const sameMonth = race.date_end.slice(5, 7) === race.date_start.slice(5, 7);
    return { text: sameMonth ? `${d}–${ed}` : `${d}→`, range: true, approx: false };
  }
  return { text: String(d), approx: false };
})() as { text: string; approx: boolean; range?: boolean };

// Marquee events carry a third badge; everything else gets two. The cap is
// tighter than the list's four because the cell is narrower, not because the
// data is different — the full set is on the permalink page and in the tooltip.
const cap = race.marquee ? 3 : 2;
const badges = race.badges.shown.length > cap
  ? race.badges.shown.slice(0, cap)
  : race.badges.shown;
const overflow = race.badges.overflow + Math.max(0, race.badges.shown.length - badges.length);
---

<li
  {...filterAttrs(race)}
  class:list={['ev', race.marquee && 'is-marquee', race.status !== 'active' && `is-${race.status}`]}
>
  <span
    class:list={['day', day.approx && 'is-approx', day.range && 'is-range']}
    title={race.date.full}>{day.text}</span
  >

  <span class="body">
    <a class="name" href={raceHref(race)}>
      {race.marquee && <span class="star" aria-label="Marquee event">★</span>}
      {race.name}
    </a>

    <span class="meta">
      <span class="town">{race.location.town}</span>
      {status && <span class="pill">{status.label}</span>}
    </span>

    <span class="tags" title={race.badges.all}>
      {formatTags.map((t) => <span class="tag">{t}</span>)}
      {badges.map((b) => <span class="badge">{b}</span>)}
      {overflow > 0 && <span class="more">+{overflow}</span>}
    </span>
  </span>
</li>

<style>
  .ev {
    position: relative;
    display: grid;
    grid-template-columns: 2.6rem minmax(0, 1fr);
    gap: 0 0.5rem;
    padding: 0.5rem 0.6rem 0.5rem 0.5rem;
    border-top: 1px solid var(--line-soft);
    border-left: 3px solid transparent;
  }
  .ev:hover {
    background: var(--ink-850);
  }

  /* The whole cell is the hit area; the name is the one real link in it. */
  .name::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .day {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.15;
    text-align: right;
    color: var(--fg-dim);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .day.is-approx {
    color: var(--fg-mute);
    cursor: help;
  }
  /*
   * A multi-day event's "25–27" is three times the width of a "5" and was
   * spilling out of the day track into the race name. It steps down a size
   * rather than widening the track for everyone — single days are the common
   * case and the column reads better staying tight.
   */
  .day.is-range {
    font-size: 0.8rem;
    letter-spacing: -0.01em;
  }

  .body {
    display: block;
    min-width: 0;
  }
  .name {
    display: block;
    font-family: var(--font-display);
    font-size: 0.94rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--fg);
    text-decoration: none;
  }
  .ev:hover .name {
    color: #fff;
    text-decoration: underline;
    text-decoration-color: var(--teal-edge);
  }
  .star {
    color: var(--gold);
    font-size: 0.85em;
    margin-right: 0.1rem;
  }

  .meta {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.3rem 0.45rem;
    margin-top: 0.12rem;
    font-size: 0.74rem;
    color: var(--fg-mute);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.22rem;
    margin-top: 0.3rem;
  }
  .badge,
  .tag,
  .more {
    font-family: var(--font-display);
    font-size: 0.67rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.35;
    padding: 0.08rem 0.3rem;
    border-radius: 2px;
    max-width: 100%;
    overflow-wrap: anywhere;
  }
  .badge {
    color: var(--teal);
    background: var(--teal-wash);
    border: 1px solid var(--teal-edge);
  }
  .tag {
    color: var(--fg-dim);
    border: 1px solid var(--line);
    text-transform: uppercase;
    font-size: 0.6rem;
    letter-spacing: 0.12em;
  }
  .more {
    color: var(--fg-mute);
    border: 1px dashed var(--line);
  }

  .pill {
    font-family: var(--font-display);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.06rem 0.3rem;
    border-radius: 2px;
    border: 1px solid currentcolor;
  }

  /* ---- ★ marquee: the poster's loudest voice, unchanged from Phase 3 ---- */
  .is-marquee {
    border-left-color: var(--gold-deep);
    background: linear-gradient(90deg, var(--gold-wash), transparent 88%);
  }
  .is-marquee:hover {
    background: linear-gradient(90deg, var(--gold-wash), transparent 88%), var(--ink-850);
  }
  .is-marquee .name {
    font-size: 1.06rem;
    color: #fff;
  }
  .is-marquee .day {
    color: var(--gold);
  }
  .is-marquee .meta {
    color: var(--fg-dim);
  }

  /* ---- status: same three treatments as the list view ---- */
  .is-returning {
    border-left-color: var(--teal-deep);
  }
  .is-returning .pill {
    color: var(--teal);
    background: var(--teal-wash);
  }

  .is-discontinued {
    border-left-color: var(--rust);
    background: repeating-linear-gradient(
      -45deg,
      transparent 0 9px,
      rgb(201 117 92 / 4%) 9px 18px
    );
  }
  .is-discontinued .pill {
    color: var(--rust);
    background: var(--rust-wash);
  }
  .is-discontinued .name,
  .is-discontinued .day {
    color: var(--fg-mute);
  }
  .is-discontinued .badge,
  .is-discontinued .tag {
    opacity: 0.55;
  }

  .is-unverified {
    border-left: 3px dashed var(--gold-deep);
  }
  .is-unverified .pill {
    color: var(--gold);
    background: var(--gold-wash);
  }
  .is-unverified .name {
    color: var(--fg-dim);
  }

  /* ---- touch: a calendar cell still has to be tappable ---- */
  @media (max-width: 59.99rem) {
    .ev {
      padding: 0.65rem 0.7rem 0.65rem 0.6rem;
    }
    .name {
      font-size: 1rem;
    }
    .is-marquee .name {
      font-size: 1.1rem;
    }
    .meta,
    .badge,
    .tag,
    .more {
      font-size: 0.76rem;
    }
    .tag {
      font-size: 0.66rem;
    }
  }
</style>
