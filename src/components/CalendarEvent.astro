---
// One event row inside a calendar month box.
//
// Deliberately a single compact line, not the card this used to be. Two
// reasons, and they're the same reason from two directions:
//
//   1. It answers the "the calendar reads as the list view" complaint. The town,
//      the hook text and the companion distances all live one click away on the
//      permalink and one view away on the list. A calendar's job is *when*; the
//      row carries the day, the name, and one distance chip, and the day-timeline
//      above it carries the shape of the month. Stripping the row of everything
//      the list already says better is what makes the two views distinct.
//   2. It is the main lever on the dead-space problem. A row-major grid makes
//      every box in a row as tall as that row's tallest box, so height variance
//      between months is the cost. Compact rows are ~26px against the old
//      cards' ~70px, which cuts the variance — and therefore the wasted space —
//      by roughly two thirds before layout is touched at all. See
//      ARCHITECTURE.md §7 item 4.
//
// The visual language itself is unchanged from Phase 3/4: ★ marquee in gold,
// teal rule for returning, rust over hatching for discontinued, dashed gold for
// unverified, teal chip for the distance.
import { filterAttrs, raceHref, STATUS_NOTE, type RaceView } from '../lib/races';

interface Props {
  race: RaceView;
}

const { race } = Astro.props;
const status = race.status === 'active' ? null : STATUS_NOTE[race.status];

// The lead glyph. A confirmed date gets its day number; anything else gets a
// tilde, matching the list view and matching where the timeline puts it — an
// unconfirmed event sits in the strip's "~" gutter rather than on a day.
// The gate is `date_confirmed`, not the presence of `date_start`, which is why
// Leadville Trail 100 reads "~15–16" and not "15–16".
const day = (() => {
  if (!race.date_confirmed || !race.date_start) return { text: '~', approx: true };
  const d = Number(race.date_start.slice(8, 10));
  if (race.date_end) {
    const ed = Number(race.date_end.slice(8, 10));
    const sameMonth = race.date_end.slice(5, 7) === race.date_start.slice(5, 7);
    return { text: sameMonth ? `${d}–${ed}` : `${d}→`, approx: false, range: true };
  }
  return { text: String(d), approx: false };
})() as { text: string; approx: boolean; range?: boolean };
---

<li
  {...filterAttrs(race)}
  data-ev={race.slug}
  class:list={['ev', race.marquee && 'is-marquee', race.status !== 'active' && `is-${race.status}`]}
>
  <span
    class:list={['d', day.approx && 'is-approx', day.range && 'is-range']}
    title={race.date.full}>{day.text}</span
  >
  <a class="nm" href={raceHref(race)} title={status ? `${race.name} — ${status.label}` : race.name}>
    {race.marquee && <span class="star" aria-label="Marquee event">★</span>}{race.name}
  </a>
  {status && <span class="pill" title={status.blurb}>{status.label.slice(0, 4)}</span>}
  <span class="bd">{race.categoryLabel}</span>
</li>

<style>
  .ev {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    padding: 0.28rem 0.55rem 0.28rem 0.4rem;
    border-top: 1px solid var(--line-soft);
    border-left: 3px solid transparent;
    line-height: 1.35;
  }
  .ev:hover,
  /* Set by the timeline script when a mark is picked — the row is what the
     mark points at, so it has to be findable once you get there. */
  .ev.is-cued {
    background: var(--ink-850);
  }
  .ev.is-cued {
    outline: 1px solid var(--teal-edge);
    outline-offset: -1px;
  }

  .d {
    flex: none;
    width: 2.4rem;
    text-align: right;
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--fg-dim);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .d.is-approx {
    color: var(--fg-mute);
    cursor: help;
  }
  /* "25–27" is three times the width of a "5"; it steps down rather than
     widening the column for the common single-day case. */
  .d.is-range {
    font-size: 0.72rem;
    letter-spacing: -0.01em;
  }

  .nm {
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--fg);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* The whole row is the hit area; the name is its one real link. */
  .nm::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .ev:hover .nm,
  .ev.is-cued .nm {
    color: #fff;
  }
  .star {
    color: var(--gold);
    font-size: 0.85em;
    margin-right: 0.2em;
  }

  .bd {
    flex: none;
    font-family: var(--font-display);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    padding: 0.05rem 0.28rem;
    border-radius: 2px;
    color: var(--teal);
    background: var(--teal-wash);
    border: 1px solid var(--teal-edge);
    white-space: nowrap;
  }
  .pill {
    flex: none;
    font-family: var(--font-display);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.02rem 0.24rem;
    border-radius: 2px;
    border: 1px solid currentcolor;
    cursor: help;
  }

  /* ---- ★ marquee ---- */
  .is-marquee {
    border-left-color: var(--gold-deep);
    background: linear-gradient(90deg, var(--gold-wash), transparent 92%);
  }
  .is-marquee:hover,
  .is-marquee.is-cued {
    background: linear-gradient(90deg, var(--gold-wash), transparent 92%), var(--ink-850);
  }
  .is-marquee .nm {
    font-weight: 600;
    color: #fff;
  }
  .is-marquee .d {
    color: var(--gold);
  }

  /* ---- status: the same three treatments as the list view ---- */
  .is-returning {
    border-left-color: var(--teal-deep);
  }
  .is-returning .pill {
    color: var(--teal);
    background: var(--teal-wash);
  }

  .is-discontinued {
    border-left-color: var(--rust);
    background: repeating-linear-gradient(
      -45deg,
      transparent 0 9px,
      rgb(201 117 92 / 4%) 9px 18px
    );
  }
  .is-discontinued .pill {
    color: var(--rust);
    background: var(--rust-wash);
  }
  .is-discontinued .nm,
  .is-discontinued .d {
    color: var(--fg-mute);
  }
  .is-discontinued .bd {
    opacity: 0.55;
  }

  .is-unverified {
    border-left: 3px dashed var(--gold-deep);
  }
  .is-unverified .pill {
    color: var(--gold);
    background: var(--gold-wash);
  }
  .is-unverified .nm {
    color: var(--fg-dim);
  }

  /* ---- touch: a row still has to be tappable ---- */
  @media (max-width: 59.99rem) {
    .ev {
      padding-block: 0.45rem;
      gap: 0.5rem;
    }
    .nm {
      font-size: 0.95rem;
    }
    .d {
      font-size: 0.92rem;
    }
    .bd {
      font-size: 0.7rem;
    }
  }
</style>
